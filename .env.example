# ============================================================
# Intelligent Job Search, Recommendation & Recruitment Analytics
# Copy this file to backend/.env and frontend/.env
# (or run `npm run setup:env` at the repo root)
# ============================================================

# ---- Backend (Node/Express/Prisma) ----
# docker-compose maps host port 5433 -> container 5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/job_platform"

# JWT
JWT_SECRET="change-me-dev-secret"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

# Server
PORT=4000
NODE_ENV=development

# CORS (comma separated origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"

# Basic rate limiting (requests per window) for auth endpoints
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Frontend (Vite) ----
VITE_API_URL="http://localhost:4000/api"
